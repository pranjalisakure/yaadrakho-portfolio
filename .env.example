# Local or Vercel Preview database. Keep production credentials separate.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Only needed to register or reset the protected YaadRakho owner email.
OWNER_SETUP_CODE=

# Web Push keys and the protected Vercel Cron endpoint.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=

# Account verification and forgot-password emails (server-only).
RESEND_API_KEY=
AUTH_EMAIL_FROM=
PUBLIC_APP_URL=
# Preview only: retain failed-email signups for explicit owner approval.
# Hard-gated by VERCEL_ENV=preview; never enable this in Production.
ALLOW_PREVIEW_MANUAL_VERIFICATION=false

# Optional official WhatsApp Business Cloud API for direct bill delivery.
# Without these, YaadRakho prepares and opens the bill message for manual confirmation.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BILL_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=
WHATSAPP_GRAPH_API_VERSION=

# Razorpay Standard Checkout (server-only). Start with rzp_test_ keys.
# Keep disabled until the three secrets are configured in Vercel Preview.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Leave false during Test Mode. Live keys require a separate launch review.
RAZORPAY_ALLOW_LIVE=false
# Phase 8: require an active Razorpay Route linked account per business.
# Keep false in Production until Route approval, linked-account KYC, and launch review are complete.
RAZORPAY_ROUTE_ENABLED=false

# Preview demo only. Ignored outside Vercel Preview and never enables live keys.
RAZORPAY_PREVIEW_SHARED_TEST_MODE=false

# Optional mobile login and password recovery. Disabled until provider setup and delivery testing.
# Existing email/password and email reset continue without SMS.
SMS_OTP_ENABLED=false
SMS_OTP_PROVIDER=twilio_verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Local demo only: direct verification/reset links, no delivery. Never enable for deployment.
# Requires a file: database, a loopback PUBLIC_APP_URL, and no VERCEL/VERCEL_ENV.
ALLOW_LOCAL_DEMO_AUTH=false

# Vercel Preview only: explicitly separate from the production database.
PREVIEW_TURSO_DATABASE_URL=
PREVIEW_TURSO_AUTH_TOKEN=

# Alternate Preview pair created by the YAADRAKHO_TEST Vercel Turso integration.
YAADRAKHO_TEST_TURSO_DATABASE_URL=
YAADRAKHO_TEST_TURSO_AUTH_TOKEN=
